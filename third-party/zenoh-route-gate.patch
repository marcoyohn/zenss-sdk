+                }
+                DeclareBody::UndeclareKeyExpr(declaration) => {
+                    if let Ok(mut ids) = self.resource_ids.lock() {
+                        ids.remove(&declaration.id);
+                    }
+                    true
+                }
+                DeclareBody::UndeclareQueryable(declaration) => {
+                    if self.flow == RouteFlow::Ingress {
