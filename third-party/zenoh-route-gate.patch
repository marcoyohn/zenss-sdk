+    async fn wildcard_matching_edges_are_bounded_atomic_and_reclaimed() {
+        let config =
+            crate::Config::from_json5(r#"{mode:"router",scouting:{multicast:{enabled:false}}}"#)
+                .unwrap();
+        let router = RuntimeBuilder::new(config).build().await.unwrap();
