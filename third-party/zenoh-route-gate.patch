+                    .is_none());
+                    declare(10001, &expr, false, &mut |_, _| {});
+                    assert_eq!(counts(), full);
+                    undeclare(10000, &mut |_, _| {});
+                    assert_eq!(counts().0[0], full.0[0] - 1);
+                    declare(20000, &expr, true, &mut |_, _| {});
+                    assert_eq!(counts(), full);
+                    for id in 10001..11984 {
+                        undeclare(id, &mut |_, _| {});
