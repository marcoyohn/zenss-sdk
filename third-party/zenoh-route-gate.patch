+                assert!(!retained.is_empty());
+                assert!(retained.len() <= 248);
+                let full = counts();
+                let before = {
+                    let tables = gateway.tables.tables.read().unwrap();
+                    tables
+                        .data
+                        .faces
+                        .values()
