+                    "refused/interest"
+                )
+                .is_none());
+                let after = {
+                    let tables = gateway.tables.tables.read().unwrap();
+                    tables
+                        .data
+                        .faces
+                        .values()
+                        .map(|f| {
+                            (
+                                f.id,
+                                f.local_interests.len(),
+                                f.pending_current_interests.len(),
+                                f.next_native_interest_id.load(Ordering::SeqCst),
